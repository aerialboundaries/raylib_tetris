{
  "version": 3,
  "configurePresets": [
    {
      "name": "win",
      "displayName": "Windows MinGW Cross Compile",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/win",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc"
      }
    },
    {
      "name": "win-native",
      "displayName": "Windows Native (MinGW)",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/win-native",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/mingw64/bin/gcc.exe"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux Native (WSL)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "web",
      "displayName": "Web (Emscripten)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/web",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
      }
    }
  ]
}
