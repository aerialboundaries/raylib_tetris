# ----------------------------------------------------
# Windows (w64devkit) 用 clangd 設定（解析パニック防止版）
# ----------------------------------------------------
CompilationDatabase: "build"

CompileFlags:
  # clangd に GCC (MinGW-w64) ターゲットであることを教える
  Add:
    - "--target=x86_64-w64-mingw32"
    - "-IC:/raylib/w64devkit/include"

  # w64devkit の GCC 本体からシステム内部マクロとヘッダ情報を自動同期させる
  Compiler: gcc
  QueryDriver:
    - "C:/raylib/w64devkit/bin/gcc.exe"
    - "C:\\raylib\\w64devkit\\bin\\gcc.exe"
    - "C:/raylib/w64devkit/bin/cc.exe"
    - "C:\\raylib\\w64devkit\\bin\\cc.exe"

Diagnostics:
  UnusedIncludes: Strict
