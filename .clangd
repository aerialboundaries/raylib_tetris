# ----------------------------------------------------
# Windows (w64devkit) / WSL (Ubuntu) 共用 .clangd
# ----------------------------------------------------

CompilationDatabase: "build"


CompileFlags:
  Compiler: gcc
  QueryDriver:
    - "C:/w64devkit/bin/gcc.exe"
    - "/usr/bin/gcc"

  Add:
    - "-std=c99"
    - "-Wall"
    - "-Wextra"
    # WindowsとWSL双方のraylibインクルードパス
    - "-IC:/raylib/include"
    - "-I/usr/local/include"


Diagnostics:
  UnusedIncludes: Strict
